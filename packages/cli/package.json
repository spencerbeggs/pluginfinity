{
	"name": "@pluginfinity/cli",
	"version": "0.3.12",
	"private": true,
	"description": "The pluginfinity command-line front end. Install the pluginfinity package to get the pluginfinity bin.",
	"keywords": ["pluginfinity", "agent-plugin", "cli", "effect"],
	"homepage": "https://github.com/spencerbeggs/pluginfinity/tree/main/packages/cli#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/pluginfinity/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/pluginfinity.git",
		"directory": "packages/cli"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./main": "./src/main.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "node savvy.build.ts --target dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effected",
		"@effected/cli": "catalog:effected",
		"@effected/commands": "catalog:effected",
		"@effected/config-file": "catalog:effected",
		"@effected/engine": "catalog:effected",
		"@effected/env": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/semver": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/xdg": "catalog:effected",
		"@pluginfinity/core": "workspace:*",
		"@pluginfinity/engine": "workspace:*",
		"@pluginfinity/targets": "workspace:*",
		"effect": "catalog:effected",
		"jiti": "^2.6.1"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@savvy-web/bundler": "^2.7.1",
		"@types/node": "catalog:build",
		"typescript": "catalog:build"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
