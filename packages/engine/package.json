{
	"name": "@pluginfinity/engine",
	"version": "0.0.1",
	"private": true,
	"description": "The pluginfinity build pipeline shared by every pluginfinity front end: config discovery, read, transform per target, emit and check.",
	"keywords": ["pluginfinity", "agent-plugin", "effect"],
	"homepage": "https://github.com/spencerbeggs/pluginfinity/tree/main/packages/engine#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/pluginfinity/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/pluginfinity.git",
		"directory": "packages/engine"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "node savvy.build.ts --target dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effected/commands": "catalog:effected",
		"@effected/engine": "catalog:effected",
		"@effected/glob": "catalog:effected",
		"@effected/semver": "catalog:effected",
		"@effected/walker": "catalog:effected",
		"@effected/yaml": "catalog:effected",
		"@pluginfinity/core": "workspace:*",
		"@pluginfinity/targets": "workspace:*",
		"jiti": "^2.6.1"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@effected/memfs": "catalog:effected",
		"@savvy-web/bundler": "^2.4.20",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "catalog:build"
	},
	"peerDependencies": {
		"@effect/platform-node": "catalog:effect:peers",
		"effect": "catalog:effect:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
