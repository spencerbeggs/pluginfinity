{
	"name": "@pluginfinity/targets",
	"version": "0.1.1",
	"private": true,
	"description": "The host targets pluginfinity builds for (Claude Code, GitHub Copilot), described as data against the @pluginfinity/core Target schema.",
	"keywords": ["pluginfinity", "claude-code", "copilot", "agent-plugin", "effect"],
	"homepage": "https://github.com/spencerbeggs/pluginfinity/tree/main/packages/targets#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/pluginfinity/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/pluginfinity.git",
		"directory": "packages/targets"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:dev": "node savvy.build.ts --target dev",
		"build:prod": "node savvy.build.ts --target prod",
		"prepare": "node savvy.build.ts --target dev",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@pluginfinity/core": "workspace:*"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@savvy-web/bundler": "^2.4.20",
		"@types/node": "catalog:build",
		"effect": "catalog:effect",
		"typescript": "catalog:build"
	},
	"peerDependencies": {
		"effect": "catalog:effect:peers"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist/dev/pkg",
		"linkDirectory": true,
		"targets": {
			"npm": true
		}
	}
}
