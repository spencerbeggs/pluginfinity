{
	"name": "pluginfinity",
	"version": "0.3.17",
	"private": true,
	"description": "Build one agent-plugin source into every host's format: Claude Code, GitHub Copilot and more, from a single config.",
	"keywords": ["claude-code", "copilot", "agent-plugin", "plugin", "cli", "effect"],
	"homepage": "https://github.com/spencerbeggs/pluginfinity/tree/main/packages/pluginfinity#readme",
	"bugs": {
		"url": "https://github.com/spencerbeggs/pluginfinity/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spencerbeggs/pluginfinity.git",
		"directory": "packages/pluginfinity"
	},
	"license": "MIT",
	"author": {
		"name": "C. Spencer Beggs",
		"email": "spencer@beggs.codes",
		"url": "https://spencerbeg.gs"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"bin": {
		"pluginfinity": "./src/bin/pluginfinity.ts"
	},
	"scripts": {
		"build": "effected package build",
		"types:check": "tsc --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:effected:exact",
		"@effected/cli-kit": "catalog:effected:exact",
		"@effected/commands": "catalog:effected:exact",
		"@effected/config-file": "catalog:effected:exact",
		"@effected/env": "catalog:effected:exact",
		"@effected/glob": "catalog:effected:exact",
		"@effected/kit": "catalog:effected:exact",
		"@effected/semver": "catalog:effected:exact",
		"@effected/walker": "catalog:effected:exact",
		"@effected/xdg": "catalog:effected:exact",
		"@pluginfinity/cli": "workspace:*",
		"@pluginfinity/core": "workspace:*",
		"@pluginfinity/engine": "workspace:*",
		"@pluginfinity/targets": "workspace:*",
		"effect": "catalog:effected:exact",
		"jiti": "^2.6.1"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effected",
		"@effected/jsonc": "catalog:effected",
		"@effected/toml": "catalog:effected",
		"@effected/workspaces": "catalog:effected",
		"@types/node": "catalog:effected:build",
		"typescript": "catalog:effected:build"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"publishConfig": {
		"access": "public",
		"targets": {
			"npm": true
		}
	}
}
