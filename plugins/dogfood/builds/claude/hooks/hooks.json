{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
						],
						"timeout": 5
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.sh"
						],
						"timeout": 5
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bash",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-use.sh"
						],
						"timeout": 5
					}
				]
			},
			{
				"matcher": "Read",
				"hooks": [
					{
						"type": "command",
						"command": "bash",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/hooks/crash.sh"
						],
						"timeout": 5
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bash",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.sh"
						],
						"timeout": 5
					}
				]
			},
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "bash",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/hooks/post-edit.sh"
						],
						"timeout": 5
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/hooks/subagent-start.sh"
						],
						"timeout": 5
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash",
						"args": [
							"${CLAUDE_PLUGIN_ROOT}/hooks/stop.sh"
						],
						"timeout": 5
					}
				]
			}
		]
	}
}
